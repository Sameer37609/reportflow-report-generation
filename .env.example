# Local development only. Copy/configure as .env; never commit real credentials.
# Password must be URL-encoded. scripts/configure-local-db.ps1 handles this.
DATABASE_URL="postgresql://reportflow_user:YOUR_URL_ENCODED_PASSWORD@localhost:5432/reportflow_dev?schema=public"

# Required: local for PostgreSQL development, demo for public read-only hosting.
REPORTFLOW_MODE=local
