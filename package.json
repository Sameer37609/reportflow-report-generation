{
  "name": "reportflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/calculations.test.ts tests/exports.test.ts tests/security-overrides.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "test:db": "node tests/database-api.mjs",
    "postinstall": "prisma generate",
    "demo:dev": "node scripts/demo.mjs dev --webpack --hostname 127.0.0.1",
    "demo:build": "node scripts/demo.mjs build --webpack",
    "demo:start": "node scripts/demo.mjs start --hostname 127.0.0.1",
    "test:demo": "node tests/demo-api.mjs",
    "test:config": "node tests/config-startup.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
